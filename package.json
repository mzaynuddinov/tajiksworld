{
  "name": "tajiksworld",
  "private": true,
  "version": "1.0.0",
  "description": "Build tools for the TajiksWorld WordPress theme.",
  "scripts": {
    "build:css": "tailwindcss -i ./resources/css/theme.css -o ./assets/css/theme.css --minify",
    "build:js": "node bin/build-js.mjs",
    "build": "npm run build:css && npm run build:js",
    "i18n": "node bin/compile-translations.mjs",
    "test": "node tests/run-node-tests.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "tailwindcss": "^3.4.17"
  }
}
